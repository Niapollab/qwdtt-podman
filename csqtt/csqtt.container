[Unit]
Description=CSQTT VPN Server Container
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/csqtt:latest
ContainerName=csqtt
AutoUpdate=local

# Network & Isolation settings
DropCapability=ALL
AddCapability=NET_ADMIN NET_RAW
AddDevice=/dev/net/tun

# Sysctl inside the container namespace for routing
Sysctl=net.ipv4.ip_forward=1

# Persistent volume for SQLite database (csqtt.db), TLS certs, and secrets
Volume=csqtt-cfg:/etc/csqtt:Z

# Read environment variables (ports, passwords, DNS, web settings)
EnvironmentFile=%h/.config/csqtt/config

# Dynamic port publishing via PodmanArgs using environment variables
PodmanArgs=--publish ${CSQTT_PEER_PORT}:${CSQTT_PEER_PORT}/udp --publish 127.0.0.1:${CSQTT_WEB_PORT}:${CSQTT_WEB_PORT}/tcp

[Service]
EnvironmentFile=%h/.config/csqtt/config
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
