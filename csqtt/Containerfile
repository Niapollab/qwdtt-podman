# Base on Ubuntu LTSC 24.04
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Required by CSQTT when running as PID 1 in a container so that self-restart
# signals PID 1 instead of systemctl and TPROXY child processes accept PID 1 parent.
ENV CSQTT_SERVICE_MANAGER=docker

# Install required dependencies:
# - iptables & iproute2: for TUN device (csqtt1) management, NAT MASQUERADE, and routing
# - openssl & ca-certificates: for TLS certificate and secret generation
# - curl: used by CSQTT fallback public IPv4 detection
# - procps & kmod: process management and kernel modules support
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssl \
    iproute2 \
    iptables \
    procps \
    kmod \
    && rm -rf /var/lib/apt/lists/*

# Create config directory and mount point
RUN mkdir -p /etc/csqtt /usr/local/bin

# Copy csqtt binary and entrypoint script
COPY server /usr/local/bin/csqtt
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/csqtt /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
