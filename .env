# ==============================================================================
# WDTT VPN Server Environment Configuration
# Location: /etc/default/qwdtt (or referenced by Quadlet)
# ==============================================================================

# REQUIRED: Master password for WDTT (must be uncommented and set; cannot be empty)
# WDTT_MAIN_PASSWORD=your_secure_password_here

# Port configurations
WDTT_DTLS_PORT=56000
WDTT_WG_PORT=56001
WDTT_DIRECT_PORT=56002
WDTT_RAW_PORT=56003
WDTT_ADMIN_PORT=56004

# DNS Configuration
WDTT_DNS_SERVERS=1.1.1.1,1.0.0.1

# Optional parameters:
# WDTT_ADMIN_ID=
# WDTT_BOT_TOKEN=
