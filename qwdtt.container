[Unit]
Description=WDTT VPN Server Container
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/qwdtt:latest
ContainerName=qwdtt
AutoUpdate=local

# Network & Isolation settings
DropCapability=ALL
AddCapability=NET_ADMIN NET_RAW
AddDevice=/dev/net/tun

# Sysctl inside the container namespace for routing
Sysctl=net.ipv4.ip_forward=1

# Persistent volume for secrets, certificates, and user database
Volume=qwdtt-cfg:/etc/qwdtt:Z

# Read environment variables (ports, password, DNS, tokens)
EnvironmentFile=/etc/default/qwdtt

# Dynamic port publishing via PodmanArgs using environment variables
PodmanArgs=--publish ${WDTT_DTLS_PORT}:${WDTT_DTLS_PORT}/udp --publish ${WDTT_DTLS_PORT}:${WDTT_DTLS_PORT}/tcp --publish ${WDTT_WG_PORT}:${WDTT_WG_PORT}/udp --publish 127.0.0.1:${WDTT_ADMIN_PORT}:${WDTT_ADMIN_PORT}/tcp --publish ${WDTT_DIRECT_PORT}:${WDTT_DIRECT_PORT}/udp --publish ${WDTT_DIRECT_PORT}:${WDTT_DIRECT_PORT}/tcp --publish ${WDTT_RAW_PORT}:${WDTT_RAW_PORT}/udp

[Service]
EnvironmentFile=/etc/default/qwdtt
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
